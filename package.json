{
  "name": "disksweepr",
  "version": "1.1.0",
  "description": "High-performance, safety-first desktop disk cleaning utility for Windows",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.json",
    "dist:portable": "electron-builder --config electron-builder.json --win portable",
    "preview": "vite preview",
    "test": "node --test tests/filters.test.ts tests/emptyFolder.test.ts tests/rules.test.ts tests/largeFiles.test.ts tests/fastSearch.test.ts tests/duplicates.test.ts tests/recovery.test.ts tests/recoveryUtils.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}

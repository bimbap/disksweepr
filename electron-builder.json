{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.disksweepr.app",
  "productName": "DiskSweepr",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/**/*",
    "package.json"
  ],
  "compression": "normal",
  "publish": {
    "provider": "github",
    "owner": "bimbap",
    "repo": "disksweepr"
  },
  "win": {
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "nsis-web",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeader": "build/installerHeader.bmp",
    "installerHeaderIcon": "build/icon.ico",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/uninstallerSidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DiskSweepr",
    "uninstallDisplayName": "DiskSweepr - Storage Cleanup Utility",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "DiskSweepr-Setup-${version}.exe"
  },
  "nsisWeb": {
    "appPackageUrl": "https://github.com/bimbap/disksweepr/releases/download/v${version}/",
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "include": "build/installer.nsh",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeader": "build/installerHeader.bmp",
    "installerHeaderIcon": "build/icon.ico",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/uninstallerSidebar.bmp",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DiskSweepr",
    "uninstallDisplayName": "DiskSweepr - Storage Cleanup Utility",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "DiskSweepr-Web-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "DiskSweepr-Portable-${version}.exe",
    "unpackDirName": "DiskSweepr-Runtime",
    "requestExecutionLevel": "admin"
  }
}
